---
layout: layouts/page.njk
currentPage: home
title: "Selina Liu's Portfolio"
description: "Selina Liu — UX/HCI portfolio: case studies in human-centered app design."
permalink: index.html
---
      <section class="laptop-hero" id="laptopHero">
        <div class="laptop-hero_scene">
          <div class="laptop-hero_rig">
            <div class="laptop-hero_laptop">
              <div class="laptop-hero_hinge">
                <div class="laptop-hero_base"><div class="laptop-hero_trackpad"></div></div>
                <div class="laptop-hero_lid">
                  <div class="laptop-hero_bezel">
                    <div class="laptop-hero_screen-viewport">
                      <div class="laptop-hero_screen-content">
                        <div class="mini-hero">
                          <p class="mini-hero_eyebrow">Welcome to my</p>
                          <p class="mini-hero_line1">PORTFOLIO</p>
                          <p class="mini-hero_line2">SELINA</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="laptop-hero_shadow"></div>
        </div>
      </section>
      <section class="home-hero" id="homeHero">
        <p class="home-hero_eyebrow">Welcome to my</p>
        <div class="home-hero_name">
          <span class="home-hero_name-word is-portfolio">PORTFOLIO</span>
        </div>
        <div class="home-hero_name-row">
          <span class="home-hero_name-word is-sel">SEL</span>
          <img class="home-hero_photo" src="images/selina-hero-cutout.png" alt="Selina Liu">
          <span class="home-hero_name-word is-ina">INA</span>
        </div>
        <p class="home-hero_intro">Hi, I'm Selina :) I'm a <strong>Computer Science</strong> undergraduate at NTU with an Innovative Design Program background, passionate about building <strong>human-centered technology</strong> at the intersection of HCI, software engineering, and user research.</p>
      </section>
      <section class="section_work-list" id="workList">
        <div class="padding-section-medium is-mobile-big"></div>
        <div class="padding-global">
          <div class="container-medium">
            <div class="work-list_component">
              <div class="work-list_head">
                <h2>Projects</h2>
                <div class="work-list_number-wrap">
                  <div class="work-list_number">{{ collections.project | length }}</div>
                </div>
              </div>
              <div class="spacer-xlarge is-mobile-small"></div>
              <div class="work-list_wrapper">
                <ul role="list" class="work-list_list">
                  {%- for project in collections.project -%}
                  <li class="work-list_item">
                    <a href="{{ project.fileSlug }}.html" class="work-list_block w-inline-block">
                      <div class="w-layout-hflex work-list_images-wrap">
                        <div class="w-layout-hflex work-list_image-main"><img src="{{ project.data.thumbnail }}" loading="lazy" sizes="100vw" srcset="{{ project.data.thumbnailSrcset }}" alt="{{ project.data.cardTitle }} thumbnail" class="image-22"></div>
                      </div>
                      <div class="w-layout-vflex work-list_infos">
                        <h6>{{ project.data.cardTitle }}</h6>
                        <div class="text-block-4">{{ project.data.cardTagline }}</div>
                      </div>
                    </a>
                  </li>
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>
